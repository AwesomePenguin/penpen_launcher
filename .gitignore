# =============================================================================
# PenPen Launcher Specific
# =============================================================================

# Application logs
logs/
*.log

# Screenshots directory (contains generated files)
screenshots/

# Backup directories (created by update scripts)
backup/
backups/

# Runtime configuration (may contain sensitive data)
.env.local
.env.production

# Process IDs and runtime state
*.pid
launcher.pid

# Temporary files
temp/
tmp/
*.tmp

